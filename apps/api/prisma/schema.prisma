generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Nivel plataforma (sin tenant_id) — ver .claude/steering/subscriptions.md
// ---------------------------------------------------------------------------

enum EstadoCuenta {
  PERIODO_PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

model Plan {
  id             String  @id @default(uuid())
  nombre         String  @unique
  maxUsuarios    Int     @map("max_usuarios")
  maxNegocios    Int     @map("max_negocios")
  precioMensual  Decimal @map("precio_mensual") @db.Decimal(10, 2)

  cuentas Cuenta[]

  @@map("planes")
}

model Cuenta {
  id              String       @id @default(uuid())
  emailTitular    String       @map("email_titular")
  planId          String       @map("plan_id")
  estado          EstadoCuenta @default(PERIODO_PRUEBA)
  fechaInicio     DateTime     @default(now()) @map("fecha_inicio")
  fechaRenovacion DateTime?    @map("fecha_renovacion")
  metodoPagoRef   String?      @map("metodo_pago_ref")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  plan     Plan      @relation(fields: [planId], references: [id])
  negocios Negocio[]
  usuarios Usuario[]

  @@map("cuentas")
}

enum EstadoNegocio {
  ACTIVO
  INACTIVO
}

model Negocio {
  id        String        @id @default(uuid())
  cuentaId  String        @map("cuenta_id")
  nombre    String
  estado    EstadoNegocio @default(ACTIVO)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  cuenta          Cuenta           @relation(fields: [cuentaId], references: [id])
  usuarioNegocios UsuarioNegocio[]
  ultimoDeUsuario Usuario[]        @relation("UltimoNegocio")
  animales        Animal[]
  potreros        Potrero[]
  productosSanitarios  ProductoSanitario[]
  aplicacionesSanitarias AplicacionSanitaria[]

  @@map("negocios")
}

model Usuario {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  nombre             String
  emailVerificadoEn  DateTime? @map("email_verificado_en")
  twoFactorEnabled   Boolean   @default(false) @map("two_factor_enabled")
  cuentaId           String    @map("cuenta_id")
  ultimoNegocioId    String?   @map("ultimo_negocio_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  cuenta               Cuenta                 @relation(fields: [cuentaId], references: [id])
  ultimoNegocio        Negocio?               @relation("UltimoNegocio", fields: [ultimoNegocioId], references: [id])
  usuarioNegocios      UsuarioNegocio[]
  refreshTokens        RefreshToken[]
  tokensRecuperacion   TokenRecuperacion[]
  tokensVerificacion   TokenVerificacionEmail[]
  aplicacionesSanitarias AplicacionSanitaria[]

  @@map("usuarios")
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN_NEGOCIO
  MAYORDOMO
  OPERARIO
  VETERINARIO_EXTERNO
}

model UsuarioNegocio {
  id        String     @id @default(uuid())
  usuarioId String     @map("usuario_id")
  negocioId String     @map("negocio_id")
  rol       RolUsuario
  createdAt DateTime   @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@unique([usuarioId, negocioId])
  @@map("usuario_negocio")
}

// ---------------------------------------------------------------------------
// Auth: tokens y auditoría de login — ver .claude/specs/auth-login/design.md
// ---------------------------------------------------------------------------

model RefreshToken {
  id          String    @id @default(uuid())
  usuarioId   String    @map("usuario_id")
  tokenHash   String    @unique @map("token_hash")
  familiaId   String    @map("familia_id")
  revocadoEn  DateTime? @map("revocado_en")
  expiraEn    DateTime  @map("expira_en")
  createdAt   DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([familiaId])
  @@map("refresh_tokens")
}

model TokenRecuperacion {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// No listada explícitamente en auth-login/design.md; necesaria para
// POST /auth/verificar-email y /auth/reenviar-verificacion (mismo patrón
// que TokenRecuperacion).
model TokenVerificacionEmail {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tokens_verificacion_email")
}

model IntentoLogin {
  id        String   @id @default(uuid())
  email     String
  ip        String
  exitoso   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("intentos_login")
}

// ---------------------------------------------------------------------------
// Ganado — ver .claude/specs/ganado/design.md
// ---------------------------------------------------------------------------

enum Especie {
  BOVINO
  BUFALINO
}

enum SexoAnimal {
  MACHO
  HEMBRA
}

enum EstadoAnimal {
  ACTIVO
  VENDIDO
  MUERTO
  EN_TRANSITO
  INACTIVO
}

enum MotivoBaja {
  VENTA
  MUERTE
  TRASLADO
  OTRO
}

model Animal {
  id                String       @id @default(uuid())
  tenantId          String       @map("tenant_id")
  identificador     String
  especie           Especie
  sexo              SexoAnimal
  fechaNacimiento   DateTime?    @map("fecha_nacimiento")
  categoria         String?
  raza              String?
  color             String?
  pesoNacimiento    Decimal?     @map("peso_nacimiento") @db.Decimal(6, 2)
  // Padre/madre como texto libre por ahora — sin vincular a otros animales
  // del sistema (árbol genealógico real, diferido).
  madreRefExterna   String?      @map("madre_ref_externa")
  padreRefExterna   String?      @map("padre_ref_externa")
  fotoUrl           String?      @map("foto_url")
  potreroActualId   String?      @map("potrero_actual_id")
  estado            EstadoAnimal @default(ACTIVO)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  negocio       Negocio      @relation(fields: [tenantId], references: [id])
  potreroActual Potrero?     @relation(fields: [potreroActualId], references: [id])
  bajas         AnimalBaja[]
  aplicacionesSanitarias AplicacionSanitaria[]

  @@unique([tenantId, identificador])
  @@index([tenantId, estado])
  @@map("animales")
}

model AnimalBaja {
  id           String     @id @default(uuid())
  tenantId     String     @map("tenant_id")
  animalId     String     @map("animal_id")
  motivo       MotivoBaja
  fecha        DateTime
  observaciones String?
  usuarioId    String     @map("usuario_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id])

  @@index([tenantId, animalId])
  @@map("animal_bajas")
}

// ---------------------------------------------------------------------------
// Potreros — ver .claude/specs/potreros/design.md
// ---------------------------------------------------------------------------

enum EstadoPotrero {
  ACTIVO
  INACTIVO
}

model Potrero {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  nombre          String
  areaHectareas   Decimal       @map("area_hectareas") @db.Decimal(8, 2)
  tipoPasto       String?       @map("tipo_pasto")
  capacidadCarga  Decimal?      @map("capacidad_carga") @db.Decimal(6, 2)
  estado          EstadoPotrero @default(ACTIVO)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  negocio  Negocio  @relation(fields: [tenantId], references: [id])
  animales Animal[]

  @@unique([tenantId, nombre])
  @@map("potreros")
}

// ---------------------------------------------------------------------------
// Sanidad — ver .claude/specs/sanidad/design.md
// ---------------------------------------------------------------------------

enum TipoProductoSanitario {
  VACUNA
  ANTIPARASITARIO
  MEDICAMENTO
  OTRO
}

enum EstadoProductoSanitario {
  ACTIVO
  INACTIVO
}

model ProductoSanitario {
  id                     String                  @id @default(uuid())
  tenantId               String                  @map("tenant_id")
  nombre                 String
  tipo                   TipoProductoSanitario
  dosisRecomendada       String?                 @map("dosis_recomendada")
  intervaloRefuerzoDias  Int?                    @map("intervalo_refuerzo_dias")
  estado                 EstadoProductoSanitario @default(ACTIVO)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  negocio      Negocio                @relation(fields: [tenantId], references: [id])
  aplicaciones AplicacionSanitaria[]

  @@unique([tenantId, nombre])
  @@map("productos_sanitarios")
}

model AplicacionSanitaria {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  animalId             String    @map("animal_id")
  productoId           String    @map("producto_id")
  fecha                DateTime
  dosisAplicada        String?   @map("dosis_aplicada")
  responsableId        String    @map("responsable_id")
  proximaFechaEsperada DateTime? @map("proxima_fecha_esperada")
  observaciones        String?
  createdAt            DateTime  @default(now()) @map("created_at")

  negocio     Negocio           @relation(fields: [tenantId], references: [id])
  animal      Animal            @relation(fields: [animalId], references: [id])
  producto    ProductoSanitario @relation(fields: [productoId], references: [id])
  responsable Usuario           @relation(fields: [responsableId], references: [id])

  @@index([tenantId, animalId])
  @@index([tenantId, proximaFechaEsperada])
  @@map("aplicaciones_sanitarias")
}
