generator client {
  provider      = "prisma-client-js"
  // "native" solo alcanza el openssl que Prisma detecta en la imagen de
  // build; las libs de Chromium (Dockerfile del módulo reportes) trajeron
  // libssl3 (openssl-3.0.x) como dependencia transitiva al runner, distinto
  // de lo que "native" había detectado — se declaran ambos explícitamente
  // para no depender de la autodetección en cada build.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Nivel plataforma (sin tenant_id) — ver .claude/steering/subscriptions.md
// ---------------------------------------------------------------------------

enum EstadoCuenta {
  PERIODO_PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

model Plan {
  id            String  @id @default(uuid())
  nombre        String  @unique
  maxUsuarios   Int     @map("max_usuarios")
  maxNegocios   Int     @map("max_negocios")
  precioMensual Decimal @map("precio_mensual") @db.Decimal(10, 2)

  cuentas Cuenta[]

  @@map("planes")
}

model Cuenta {
  id              String       @id @default(uuid())
  emailTitular    String       @map("email_titular")
  planId          String       @map("plan_id")
  estado          EstadoCuenta @default(PERIODO_PRUEBA)
  fechaInicio     DateTime     @default(now()) @map("fecha_inicio")
  fechaRenovacion DateTime?    @map("fecha_renovacion")
  metodoPagoRef   String?      @map("metodo_pago_ref")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  plan     Plan      @relation(fields: [planId], references: [id])
  negocios Negocio[]
  usuarios Usuario[]

  @@map("cuentas")
}

enum EstadoNegocio {
  ACTIVO
  INACTIVO
}

model Negocio {
  id        String        @id @default(uuid())
  cuentaId  String        @map("cuenta_id")
  nombre    String
  estado    EstadoNegocio @default(ACTIVO)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  cuenta                 Cuenta                 @relation(fields: [cuentaId], references: [id])
  usuarioNegocios        UsuarioNegocio[]
  ultimoDeUsuario        Usuario[]              @relation("UltimoNegocio")
  invitaciones           Invitacion[]
  animales               Animal[]
  potreros               Potrero[]
  productosSanitarios    ProductoSanitario[]
  aplicacionesSanitarias AplicacionSanitaria[]
  protocolosSanitarios   ProtocoloSanitario[]
  diagnosticosSanitarios DiagnosticoSanitario[]
  cuarentenas            Cuarentena[]
  registrosLeche         RegistroLeche[]
  registrosLecheTotal    RegistroLecheTotal[]
  registrosPeso          RegistroPeso[]
  servicios              Servicio[]
  diagnosticosGestacion  DiagnosticoGestacion[]
  partos                 Parto[]
  celos                  Celo[]
  destetes               Destete[]
  insumosAlimentacion    InsumoAlimentacion[]
  planesAlimentacion     PlanAlimentacion[]
  planAsignaciones       PlanAsignacion[]
  suministros            Suministro[]
  suministrosRecurrentes SuministroRecurrente[]
  reportesGenerados      ReporteGenerado[]
  animalMovimientos      AnimalMovimiento[]
  cargos                 Cargo[]
  trabajadores           Trabajador[]
  asignaciones           Asignacion[]
  asistencias            Asistencia[]
  adelantos              Adelanto[]
  prestamos              Prestamo[]

  @@map("negocios")
}

model Usuario {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  nombre            String
  emailVerificadoEn DateTime? @map("email_verificado_en")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  cuentaId          String    @map("cuenta_id")
  ultimoNegocioId   String?   @map("ultimo_negocio_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  cuenta                 Cuenta                   @relation(fields: [cuentaId], references: [id])
  ultimoNegocio          Negocio?                 @relation("UltimoNegocio", fields: [ultimoNegocioId], references: [id])
  usuarioNegocios        UsuarioNegocio[]
  refreshTokens          RefreshToken[]
  tokensRecuperacion     TokenRecuperacion[]
  tokensVerificacion     TokenVerificacionEmail[]
  aplicacionesSanitarias AplicacionSanitaria[]
  registrosLeche         RegistroLeche[]
  registrosLecheTotal    RegistroLecheTotal[]
  registrosPeso          RegistroPeso[]
  suministrosRegistrados Suministro[]
  suministrosRecurrentesCreados SuministroRecurrente[]
  reportesGenerados      ReporteGenerado[]
  movimientosRegistrados AnimalMovimiento[]
  asistenciasRegistradas Asistencia[]
  adelantosRegistrados   Adelanto[]
  prestamosRegistrados   Prestamo[]
  invitacionesEnviadas   Invitacion[]

  @@map("usuarios")
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN_NEGOCIO
  MAYORDOMO
  OPERARIO
  VETERINARIO_EXTERNO
}

model UsuarioNegocio {
  id        String     @id @default(uuid())
  usuarioId String     @map("usuario_id")
  negocioId String     @map("negocio_id")
  rol       RolUsuario
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@unique([usuarioId, negocioId])
  @@map("usuario_negocio")
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  CANCELADA
  EXPIRADA
}

model Invitacion {
  id            String           @id @default(uuid())
  email         String
  negocioId     String           @map("negocio_id")
  rol           RolUsuario
  tokenHash     String           @unique @map("token_hash")
  invitadoPorId String           @map("invitado_por")
  estado        EstadoInvitacion @default(PENDIENTE)
  expiraEn      DateTime         @map("expira_en")
  aceptadaEn    DateTime?        @map("aceptada_en")
  createdAt     DateTime         @default(now()) @map("created_at")

  negocio     Negocio @relation(fields: [negocioId], references: [id])
  invitadoPor Usuario @relation(fields: [invitadoPorId], references: [id])

  @@index([negocioId])
  @@map("invitaciones")
}

// ---------------------------------------------------------------------------
// Auth: tokens y auditoría de login — ver .claude/specs/auth-login/design.md
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String    @map("usuario_id")
  tokenHash  String    @unique @map("token_hash")
  familiaId  String    @map("familia_id")
  revocadoEn DateTime? @map("revocado_en")
  expiraEn   DateTime  @map("expira_en")
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([familiaId])
  @@map("refresh_tokens")
}

model TokenRecuperacion {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// No listada explícitamente en auth-login/design.md; necesaria para
// POST /auth/verificar-email y /auth/reenviar-verificacion (mismo patrón
// que TokenRecuperacion).
model TokenVerificacionEmail {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("tokens_verificacion_email")
}

model IntentoLogin {
  id        String   @id @default(uuid())
  email     String
  ip        String
  exitoso   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("intentos_login")
}

// ---------------------------------------------------------------------------
// Ganado — ver .claude/specs/ganado/design.md
// ---------------------------------------------------------------------------

enum Especie {
  BOVINO
  BUFALINO
}

enum SexoAnimal {
  MACHO
  HEMBRA
}

enum EstadoAnimal {
  ACTIVO
  VENDIDO
  MUERTO
  EN_TRANSITO
  INACTIVO
}

enum MotivoBaja {
  VENTA
  MUERTE
  TRASLADO
  OTRO
}

model Animal {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  identificador   String
  especie         Especie
  sexo            SexoAnimal
  fechaNacimiento DateTime?    @map("fecha_nacimiento")
  categoria       String?
  raza            String?
  color           String?
  pesoNacimiento  Decimal?     @map("peso_nacimiento") @db.Decimal(6, 2)
  // Vinculados si la madre/el padre está en el sistema (madreId/padreId);
  // si no, quedan como referencia externa de texto libre.
  madreId         String?      @map("madre_id")
  padreId         String?      @map("padre_id")
  madreRefExterna String?      @map("madre_ref_externa")
  padreRefExterna String?      @map("padre_ref_externa")
  fotoUrl         String?      @map("foto_url")
  potreroActualId String?      @map("potrero_actual_id")
  estado          EstadoAnimal @default(ACTIVO)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  negocio                Negocio               @relation(fields: [tenantId], references: [id])
  potreroActual          Potrero?              @relation(fields: [potreroActualId], references: [id])
  madre                  Animal?               @relation("AnimalMadre", fields: [madreId], references: [id])
  padre                  Animal?               @relation("AnimalPadre", fields: [padreId], references: [id])
  hijosComoMadre         Animal[]              @relation("AnimalMadre")
  hijosComoPadre         Animal[]              @relation("AnimalPadre")
  bajas                  AnimalBaja[]
  movimientos            AnimalMovimiento[]
  aplicacionesSanitarias AplicacionSanitaria[]
  diagnosticosSanitarios DiagnosticoSanitario[]
  cuarentenas            Cuarentena[]
  registrosLeche         RegistroLeche[]
  registrosPeso          RegistroPeso[]
  serviciosComoHembra    Servicio[]            @relation("ServicioHembra")
  serviciosComoMacho     Servicio[]            @relation("ServicioMacho")
  partosComoMadre        Parto[]               @relation("PartoMadre")
  partoComoCria          Parto?                @relation("PartoCria")
  celos                  Celo[]
  destetes               Destete[]

  @@unique([tenantId, identificador])
  @@index([tenantId, estado])
  @@map("animales")
}

model AnimalMovimiento {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  animalId         String   @map("animal_id")
  potreroOrigenId  String?  @map("potrero_origen_id")
  potreroDestinoId String   @map("potrero_destino_id")
  fecha            DateTime
  usuarioId        String   @map("usuario_id")
  createdAt        DateTime @default(now()) @map("created_at")

  negocio        Negocio  @relation(fields: [tenantId], references: [id])
  animal         Animal   @relation(fields: [animalId], references: [id])
  potreroOrigen  Potrero? @relation("MovimientoOrigen", fields: [potreroOrigenId], references: [id])
  potreroDestino Potrero  @relation("MovimientoDestino", fields: [potreroDestinoId], references: [id])
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([tenantId, animalId])
  @@index([tenantId, potreroDestinoId])
  @@map("animal_movimientos")
}

model AnimalBaja {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  animalId      String     @map("animal_id")
  motivo        MotivoBaja
  fecha         DateTime
  observaciones String?
  usuarioId     String     @map("usuario_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id])

  @@index([tenantId, animalId])
  @@map("animal_bajas")
}

// ---------------------------------------------------------------------------
// Potreros — ver .claude/specs/potreros/design.md
// ---------------------------------------------------------------------------

enum EstadoPotrero {
  ACTIVO
  INACTIVO
}

model Potrero {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  nombre         String
  areaHectareas  Decimal       @map("area_hectareas") @db.Decimal(8, 2)
  tipoPasto      String?       @map("tipo_pasto")
  capacidadCarga Decimal?      @map("capacidad_carga") @db.Decimal(6, 2)
  estado         EstadoPotrero @default(ACTIVO)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  negocio                Negocio                @relation(fields: [tenantId], references: [id])
  animales               Animal[]
  planAsignaciones       PlanAsignacion[]
  suministros            Suministro[]
  suministrosRecurrentes SuministroRecurrente[]
  movimientosOrigen      AnimalMovimiento[]     @relation("MovimientoOrigen")
  movimientosDestino     AnimalMovimiento[]     @relation("MovimientoDestino")
  asignacionesTrabajador Asignacion[]

  @@unique([tenantId, nombre])
  @@map("potreros")
}

// ---------------------------------------------------------------------------
// Sanidad — ver .claude/specs/sanidad/design.md
// ---------------------------------------------------------------------------

enum TipoProductoSanitario {
  VACUNA
  ANTIPARASITARIO
  MEDICAMENTO
  OTRO
}

enum EstadoProductoSanitario {
  ACTIVO
  INACTIVO
}

model ProductoSanitario {
  id                    String                  @id @default(uuid())
  tenantId              String                  @map("tenant_id")
  nombre                String
  tipo                  TipoProductoSanitario
  dosisRecomendada      String?                 @map("dosis_recomendada")
  intervaloRefuerzoDias Int?                    @map("intervalo_refuerzo_dias")
  estado                EstadoProductoSanitario @default(ACTIVO)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  negocio      Negocio               @relation(fields: [tenantId], references: [id])
  aplicaciones AplicacionSanitaria[]
  protocolos   ProtocoloSanitario[]

  @@unique([tenantId, nombre])
  @@map("productos_sanitarios")
}

model AplicacionSanitaria {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  animalId             String    @map("animal_id")
  productoId           String    @map("producto_id")
  fecha                DateTime
  dosisAplicada        String?   @map("dosis_aplicada")
  responsableId        String    @map("responsable_id")
  proximaFechaEsperada DateTime? @map("proxima_fecha_esperada")
  observaciones        String?
  createdAt            DateTime  @default(now()) @map("created_at")

  negocio     Negocio           @relation(fields: [tenantId], references: [id])
  animal      Animal            @relation(fields: [animalId], references: [id])
  producto    ProductoSanitario @relation(fields: [productoId], references: [id])
  responsable Usuario           @relation(fields: [responsableId], references: [id])
  diagnosticosTratamiento DiagnosticoSanitario[]

  @@index([tenantId, animalId])
  @@index([tenantId, proximaFechaEsperada])
  @@map("aplicaciones_sanitarias")
}

enum EstadoProtocoloSanitario {
  ACTIVO
  INACTIVO
}

model ProtocoloSanitario {
  id             String                   @id @default(uuid())
  tenantId       String                   @map("tenant_id")
  nombre         String
  productoId     String                   @map("producto_id")
  edadInicioDias Int?                     @map("edad_inicio_dias")
  frecuenciaDias Int?                     @map("frecuencia_dias")
  especie        Especie?
  sexo           SexoAnimal?
  categoria      String?
  estado         EstadoProtocoloSanitario @default(ACTIVO)
  createdAt      DateTime                 @default(now()) @map("created_at")

  negocio  Negocio           @relation(fields: [tenantId], references: [id])
  producto ProductoSanitario @relation(fields: [productoId], references: [id])

  @@index([tenantId, estado])
  @@map("protocolos_sanitarios")
}

enum GravedadDiagnostico {
  LEVE
  MODERADA
  GRAVE
}

model DiagnosticoSanitario {
  id                      String              @id @default(uuid())
  tenantId                String              @map("tenant_id")
  animalId                String              @map("animal_id")
  fecha                   DateTime
  condicion               String
  gravedad                GravedadDiagnostico
  tratamientoAplicacionId String?             @map("tratamiento_aplicacion_id")
  createdAt               DateTime            @default(now()) @map("created_at")

  negocio     Negocio              @relation(fields: [tenantId], references: [id])
  animal      Animal               @relation(fields: [animalId], references: [id])
  tratamiento AplicacionSanitaria? @relation(fields: [tratamientoAplicacionId], references: [id])

  @@index([tenantId, animalId])
  @@map("diagnosticos_sanitarios")
}

model Cuarentena {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  animalId         String    @map("animal_id")
  fechaInicio      DateTime  @map("fecha_inicio")
  fechaFinEstimada DateTime? @map("fecha_fin_estimada")
  fechaFinReal     DateTime? @map("fecha_fin_real")
  motivo           String
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")

  negocio Negocio @relation(fields: [tenantId], references: [id])
  animal  Animal  @relation(fields: [animalId], references: [id])

  @@index([tenantId, animalId])
  @@index([tenantId, activa])
  @@map("cuarentenas")
}

// ---------------------------------------------------------------------------
// Producción — ver .claude/specs/produccion/design.md
// ---------------------------------------------------------------------------

enum TurnoOrdenio {
  MANANA
  TARDE
  UNICO
}

model RegistroLeche {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  animalId      String       @map("animal_id")
  fecha         DateTime
  turno         TurnoOrdenio
  litros        Decimal      @db.Decimal(6, 2)
  registradoPor String       @map("registrado_por")
  createdAt     DateTime     @default(now()) @map("created_at")

  negocio     Negocio @relation(fields: [tenantId], references: [id])
  animal      Animal  @relation(fields: [animalId], references: [id])
  registrador Usuario @relation(fields: [registradoPor], references: [id])

  @@unique([tenantId, animalId, fecha, turno])
  @@index([tenantId, fecha])
  @@map("registros_leche")
}

// Carga rápida del total de tanque por turno, sin desglosar por animal —
// alternativa a `RegistroLeche` para negocios que no miden por vaca.
model RegistroLecheTotal {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  fecha         DateTime
  turno         TurnoOrdenio
  litrosTotal   Decimal      @map("litros_total") @db.Decimal(8, 2)
  registradoPor String       @map("registrado_por")
  createdAt     DateTime     @default(now()) @map("created_at")

  negocio     Negocio @relation(fields: [tenantId], references: [id])
  registrador Usuario @relation(fields: [registradoPor], references: [id])

  @@unique([tenantId, fecha, turno])
  @@index([tenantId, fecha])
  @@map("registros_leche_total")
}

model RegistroPeso {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  animalId      String   @map("animal_id")
  fecha         DateTime
  pesoKg        Decimal  @map("peso_kg") @db.Decimal(7, 2)
  registradoPor String   @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")

  negocio     Negocio @relation(fields: [tenantId], references: [id])
  animal      Animal  @relation(fields: [animalId], references: [id])
  registrador Usuario @relation(fields: [registradoPor], references: [id])

  @@unique([tenantId, animalId, fecha])
  @@index([tenantId, fecha])
  @@map("registros_peso")
}

// ---------------------------------------------------------------------------
// Reproducción — ver .claude/specs/reproduccion/design.md
// ---------------------------------------------------------------------------

enum TipoServicio {
  MONTA_NATURAL
  IA
  TE
}

enum EstadoServicio {
  PENDIENTE_DIAGNOSTICO
  CONFIRMADO_PRENADA
  VACIO
}

enum ResultadoDiagnostico {
  PRENADA
  VACIA
  DUDOSO
}

enum MetodoDiagnostico {
  PALPACION
  ECOGRAFIA
  OTRO
}

enum TipoParto {
  NORMAL
  DISTOCICO
  CESAREA
}

model Servicio {
  id                       String         @id @default(uuid())
  tenantId                 String         @map("tenant_id")
  animalId                 String         @map("animal_id")
  tipo                     TipoServicio
  fecha                    DateTime
  machoId                  String?        @map("macho_id")
  semenReferencia          String?        @map("semen_referencia")
  estado                   EstadoServicio @default(PENDIENTE_DIAGNOSTICO)
  fechaEstimadaDiagnostico DateTime       @map("fecha_estimada_diagnostico")
  fechaProbableParto       DateTime       @map("fecha_probable_parto")
  createdAt                DateTime       @default(now()) @map("created_at")

  negocio      Negocio                @relation(fields: [tenantId], references: [id])
  animal       Animal                 @relation("ServicioHembra", fields: [animalId], references: [id])
  macho        Animal?                @relation("ServicioMacho", fields: [machoId], references: [id])
  diagnosticos DiagnosticoGestacion[]
  parto        Parto?

  @@index([tenantId, animalId])
  @@map("servicios")
}

model DiagnosticoGestacion {
  id         String               @id @default(uuid())
  tenantId   String               @map("tenant_id")
  servicioId String               @map("servicio_id")
  resultado  ResultadoDiagnostico
  metodo     MetodoDiagnostico
  fecha      DateTime
  createdAt  DateTime             @default(now()) @map("created_at")

  negocio  Negocio  @relation(fields: [tenantId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@index([tenantId, servicioId])
  @@map("diagnosticos_gestacion")
}

model Parto {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  servicioId    String?   @unique @map("servicio_id")
  madreId       String    @map("madre_id")
  fecha         DateTime
  tipo          TipoParto
  criaAnimalId  String?   @unique @map("cria_animal_id")
  mortinato     Boolean   @default(false)
  observaciones String?
  createdAt     DateTime  @default(now()) @map("created_at")

  negocio  Negocio   @relation(fields: [tenantId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])
  madre    Animal    @relation("PartoMadre", fields: [madreId], references: [id])
  cria     Animal?   @relation("PartoCria", fields: [criaAnimalId], references: [id])

  @@index([tenantId, madreId])
  @@map("partos")
}

model Celo {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  animalId      String   @map("animal_id")
  fecha         DateTime
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")

  negocio Negocio @relation(fields: [tenantId], references: [id])
  animal  Animal  @relation(fields: [animalId], references: [id])

  @@index([tenantId, animalId])
  @@map("celos")
}

model Destete {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  animalId    String   @map("animal_id")
  fecha       DateTime
  pesoDestete Decimal? @map("peso_destete") @db.Decimal(7, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  negocio Negocio @relation(fields: [tenantId], references: [id])
  animal  Animal  @relation(fields: [animalId], references: [id])

  @@unique([tenantId, animalId])
  @@map("destetes")
}

// ---------------------------------------------------------------------------
// Alimentación — ver .claude/specs/alimentacion/design.md
// ---------------------------------------------------------------------------

enum EstadoInsumo {
  ACTIVO
  INACTIVO
}

enum TipoPlanAlimentacion {
  PASTOREO
  SUPLEMENTACION
  ESTABULADO
  MIXTO
}

enum EstadoPlanAlimentacion {
  ACTIVO
  INACTIVO
}

enum UnidadTiempoPlan {
  DIA
  SEMANA
}

enum DestinoPlanItem {
  ANIMAL
  LOTE
}

model InsumoAlimentacion {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  nombre        String
  unidadMedida  String       @map("unidad_medida")
  costoUnitario Decimal?     @map("costo_unitario") @db.Decimal(10, 2)
  estado        EstadoInsumo @default(ACTIVO)
  createdAt     DateTime     @default(now()) @map("created_at")

  negocio               Negocio                @relation(fields: [tenantId], references: [id])
  planItems             PlanAlimentacionItem[]
  suministros           Suministro[]
  suministrosRecurrentes SuministroRecurrente[]

  @@unique([tenantId, nombre])
  @@map("insumos_alimentacion")
}

model PlanAlimentacion {
  id        String                 @id @default(uuid())
  tenantId  String                 @map("tenant_id")
  nombre    String
  tipo      TipoPlanAlimentacion
  estado    EstadoPlanAlimentacion @default(ACTIVO)
  createdAt DateTime               @default(now()) @map("created_at")

  negocio      Negocio                @relation(fields: [tenantId], references: [id])
  items        PlanAlimentacionItem[]
  asignaciones PlanAsignacion[]

  @@unique([tenantId, nombre])
  @@map("planes_alimentacion")
}

model PlanAlimentacionItem {
  id           String           @id @default(uuid())
  planId       String           @map("plan_id")
  insumoId     String           @map("insumo_id")
  cantidad     Decimal          @db.Decimal(10, 2)
  unidadTiempo UnidadTiempoPlan @map("unidad_tiempo")
  por          DestinoPlanItem

  plan   PlanAlimentacion   @relation(fields: [planId], references: [id])
  insumo InsumoAlimentacion @relation(fields: [insumoId], references: [id])

  @@map("plan_alimentacion_items")
}

model PlanAsignacion {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  planId      String    @map("plan_id")
  potreroId   String?   @map("potrero_id")
  animalIds   String[]  @map("animal_ids")
  fechaInicio DateTime  @map("fecha_inicio")
  fechaFin    DateTime? @map("fecha_fin")
  createdAt   DateTime  @default(now()) @map("created_at")

  negocio Negocio          @relation(fields: [tenantId], references: [id])
  plan    PlanAlimentacion @relation(fields: [planId], references: [id])
  potrero Potrero?         @relation(fields: [potreroId], references: [id])

  @@index([tenantId, planId])
  @@map("plan_asignaciones")
}

model Suministro {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  fecha           DateTime
  insumoId        String   @map("insumo_id")
  potreroId       String?  @map("potrero_id")
  animalIds       String[] @map("animal_ids")
  cantidad        Decimal  @db.Decimal(10, 2)
  registradoPorId String   @map("registrado_por")
  esRecurrente    Boolean  @default(false) @map("es_recurrente")
  recurrenciaId   String?  @map("recurrencia_id")
  createdAt       DateTime @default(now()) @map("created_at")

  negocio       Negocio               @relation(fields: [tenantId], references: [id])
  insumo        InsumoAlimentacion    @relation(fields: [insumoId], references: [id])
  potrero       Potrero?              @relation(fields: [potreroId], references: [id])
  registradoPor Usuario               @relation(fields: [registradoPorId], references: [id])
  recurrencia   SuministroRecurrente? @relation(fields: [recurrenciaId], references: [id])

  @@index([tenantId, fecha])
  @@map("suministros")
}

enum FrecuenciaSuministro {
  DIARIA
  SEMANAL
}

model SuministroRecurrente {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  insumoId    String               @map("insumo_id")
  potreroId   String?              @map("potrero_id")
  animalIds   String[]             @map("animal_ids")
  cantidad    Decimal              @db.Decimal(10, 2)
  frecuencia  FrecuenciaSuministro
  activo      Boolean              @default(true)
  fechaInicio DateTime             @map("fecha_inicio")
  fechaFin    DateTime?            @map("fecha_fin")
  creadoPorId String               @map("creado_por")
  createdAt   DateTime             @default(now()) @map("created_at")

  negocio              Negocio            @relation(fields: [tenantId], references: [id])
  insumo               InsumoAlimentacion @relation(fields: [insumoId], references: [id])
  potrero              Potrero?           @relation(fields: [potreroId], references: [id])
  creadoPor            Usuario            @relation(fields: [creadoPorId], references: [id])
  suministrosGenerados Suministro[]

  @@index([tenantId, activo])
  @@map("suministros_recurrentes")
}

// ---------------------------------------------------------------------------
// Reportes — ver .claude/specs/reportes/design.md
// ---------------------------------------------------------------------------

enum TipoReporte {
  INVENTARIO_GANADO
  NATALIDAD_MORTALIDAD
  PRODUCCION
  COSTOS_ALIMENTACION
  CUMPLIMIENTO_SANITARIO
  OCUPACION_POTREROS
  COSTO_VS_PRODUCCION
}

enum FormatoReporte {
  PDF
  XLSX
}

enum EstadoReporte {
  PENDIENTE
  GENERANDO
  LISTO
  ERROR
}

model ReporteGenerado {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tipo            TipoReporte
  filtrosJson     Json           @map("filtros_json")
  formato         FormatoReporte
  estado          EstadoReporte  @default(PENDIENTE)
  archivoPath     String?        @map("archivo_path")
  errorMensaje    String?        @map("error_mensaje")
  solicitadoPorId String         @map("solicitado_por")
  createdAt       DateTime       @default(now()) @map("created_at")
  completadoEn    DateTime?      @map("completado_en")

  negocio       Negocio @relation(fields: [tenantId], references: [id])
  solicitadoPor Usuario @relation(fields: [solicitadoPorId], references: [id])

  @@index([tenantId, createdAt])
  @@map("reportes_generados")
}

// ---------------------------------------------------------------------------
// Trabajadores — ver .claude/specs/trabajadores/design.md (Etapa 1: base)
// ---------------------------------------------------------------------------

enum EstadoCargo {
  ACTIVO
  INACTIVO
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
}

enum TipoContratacion {
  MENSUAL
  JORNAL
  POR_ACTIVIDAD
  TEMPORAL
  OTRO
}

enum ModalidadPago {
  MENSUAL
  SEMANAL
  QUINCENAL
  DIARIO
  POR_ACTIVIDAD
}

model Cargo {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  nombre    String
  estado    EstadoCargo @default(ACTIVO)
  createdAt DateTime    @default(now()) @map("created_at")

  negocio      Negocio      @relation(fields: [tenantId], references: [id])
  trabajadores Trabajador[]
  asignaciones Asignacion[]

  @@unique([tenantId, nombre])
  @@map("cargos")
}

model Trabajador {
  id                         String           @id @default(uuid())
  tenantId                   String           @map("tenant_id")
  nombres                    String
  apellidos                  String
  documento                  String
  fechaNacimiento            DateTime?        @map("fecha_nacimiento")
  telefono                   String?
  email                      String?
  direccion                  String?
  contactoEmergenciaNombre   String?          @map("contacto_emergencia_nombre")
  contactoEmergenciaTelefono String?          @map("contacto_emergencia_telefono")
  cargoId                    String           @map("cargo_id")
  fechaIngreso               DateTime         @map("fecha_ingreso")
  tipoContratacion           TipoContratacion @map("tipo_contratacion")
  modalidadPago              ModalidadPago    @map("modalidad_pago")
  salarioOJornal             Decimal          @map("salario_o_jornal") @db.Decimal(12, 2)
  estado                     EstadoTrabajador @default(ACTIVO)
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  negocio      Negocio      @relation(fields: [tenantId], references: [id])
  cargo        Cargo        @relation(fields: [cargoId], references: [id])
  asignaciones Asignacion[]
  asistencias  Asistencia[]
  adelantos    Adelanto[]
  prestamos    Prestamo[]

  @@unique([tenantId, documento])
  @@index([tenantId, estado])
  @@map("trabajadores")
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  PERMISO
  VACACIONES
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
}

model Asistencia {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  trabajadorId    String           @map("trabajador_id")
  fecha           DateTime
  estado          EstadoAsistencia
  horaEntrada     String?          @map("hora_entrada")
  horaSalida      String?          @map("hora_salida")
  tipoJornada     String?          @map("tipo_jornada")
  jornalRealizado Decimal?         @map("jornal_realizado") @db.Decimal(5, 2)
  observaciones   String?
  registradoPorId String           @map("registrado_por")
  createdAt       DateTime         @default(now()) @map("created_at")

  negocio       Negocio    @relation(fields: [tenantId], references: [id])
  trabajador    Trabajador @relation(fields: [trabajadorId], references: [id])
  registradoPor Usuario    @relation(fields: [registradoPorId], references: [id])

  @@unique([tenantId, trabajadorId, fecha])
  @@map("asistencias")
}

model Asignacion {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  trabajadorId  String    @map("trabajador_id")
  cargoId       String?   @map("cargo_id")
  potreroId     String?   @map("potrero_id")
  fechaInicio   DateTime  @map("fecha_inicio")
  fechaFin      DateTime? @map("fecha_fin")
  observaciones String?
  createdAt     DateTime  @default(now()) @map("created_at")

  negocio    Negocio    @relation(fields: [tenantId], references: [id])
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])
  cargo      Cargo?     @relation(fields: [cargoId], references: [id])
  potrero    Potrero?   @relation(fields: [potreroId], references: [id])

  @@index([tenantId, trabajadorId])
  @@map("asignaciones")
}

enum MonedaTrabajador {
  USD
  VES
}

model Adelanto {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  trabajadorId        String           @map("trabajador_id")
  fecha               DateTime
  monto               Decimal          @db.Decimal(12, 2)
  moneda              MonedaTrabajador
  tasaCambio          Decimal?         @map("tasa_cambio") @db.Decimal(12, 4)
  montoEquivalenteUsd Decimal?         @map("monto_equivalente_usd") @db.Decimal(12, 2)
  motivo              String
  metodoEntrega       String?          @map("metodo_entrega")
  observaciones       String?
  montoDescontado     Decimal          @default(0) @map("monto_descontado") @db.Decimal(12, 2)
  registradoPorId     String           @map("registrado_por")
  createdAt           DateTime         @default(now()) @map("created_at")

  negocio       Negocio    @relation(fields: [tenantId], references: [id])
  trabajador    Trabajador @relation(fields: [trabajadorId], references: [id])
  registradoPor Usuario    @relation(fields: [registradoPorId], references: [id])

  @@index([tenantId, trabajadorId])
  @@map("adelantos")
}

model Prestamo {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  trabajadorId        String           @map("trabajador_id")
  fecha               DateTime
  montoOriginal       Decimal          @map("monto_original") @db.Decimal(12, 2)
  moneda              MonedaTrabajador
  tasaCambio          Decimal?         @map("tasa_cambio") @db.Decimal(12, 4)
  montoEquivalenteUsd Decimal?         @map("monto_equivalente_usd") @db.Decimal(12, 2)
  numeroCuotas        Int              @map("numero_cuotas")
  valorCuota          Decimal          @map("valor_cuota") @db.Decimal(12, 2)
  fechaInicio         DateTime         @map("fecha_inicio")
  observaciones       String?
  registradoPorId     String           @map("registrado_por")
  createdAt           DateTime         @default(now()) @map("created_at")

  negocio       Negocio         @relation(fields: [tenantId], references: [id])
  trabajador    Trabajador      @relation(fields: [trabajadorId], references: [id])
  registradoPor Usuario         @relation(fields: [registradoPorId], references: [id])
  abonos        PrestamoAbono[]

  @@index([tenantId, trabajadorId])
  @@map("prestamos")
}

model PrestamoAbono {
  id            String   @id @default(uuid())
  prestamoId    String   @map("prestamo_id")
  fecha         DateTime
  monto         Decimal  @db.Decimal(12, 2)
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")

  prestamo Prestamo @relation(fields: [prestamoId], references: [id])

  @@map("prestamo_abonos")
}
